{
  "version": 8,
  "name": "Apple-Style OpenFreeMap",
  "metadata": { "openfreemap:theme": "light" },
  "sources": {
    "openfreemap": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/tiles.json"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sprite": "https://tiles.openfreemap.org/sprites",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#F9F7F2" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openfreemap",
      "source-layer": "water",
      "paint": { "fill-color": "#A1D6F6" }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openfreemap",
      "source-layer": "landuse",
      "filter": ["match", ["get", "class"], ["park", "forest", "grass"], true, false],
      "paint": { "fill-color": "#D0E5C8", "fill-opacity": 0.8 }
    },
    {
      "id": "road-casing-motorway",
      "type": "line",
      "source": "openfreemap",
      "source-layer": "transportation",
      "filter": ["==", "class", "motorway"],
      "paint": {
        "line-color": "#D5A059",
        "line-width": {
          "stops": [
            [12, 1.5],
            [14, 5],
            [18, 28]
          ]
        }
      }
    },
    {
      "id": "road-casing-minor",
      "type": "line",
      "source": "openfreemap",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["minor", "street", "service"], true, false],
      "paint": {
        "line-color": "#E5E5EA",
        "line-width": {
          "stops": [
            [14, 1.5],
            [16, 4],
            [20, 20]
          ]
        }
      }
    },
    {
      "id": "road-fill-motorway",
      "type": "line",
      "source": "openfreemap",
      "source-layer": "transportation",
      "filter": ["==", "class", "motorway"],
      "paint": {
        "line-color": "#F9D390",
        "line-width": {
          "stops": [
            [12, 0.5],
            [14, 3],
            [18, 24]
          ]
        }
      }
    },
    {
      "id": "road-fill-minor",
      "type": "line",
      "source": "openfreemap",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["minor", "street", "service"], true, false],
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": {
          "stops": [
            [14, 0.5],
            [16, 3],
            [20, 18]
          ]
        }
      }
    },
    {
      "id": "building-extrusion",
      "type": "fill-extrusion",
      "source": "openfreemap",
      "source-layer": "building",
      "paint": {
        "fill-extrusion-color": "#EAE8E3",
        "fill-extrusion-height": ["get", "render_height"],
        "fill-extrusion-base": ["get", "render_min_height"],
        "fill-extrusion-opacity": 0.8
      }
    }
  ]
}
